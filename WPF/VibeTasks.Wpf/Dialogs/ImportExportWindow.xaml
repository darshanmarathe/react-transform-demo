<Window x:Class="VibeTasks.Wpf.Dialogs.ImportExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import / Export" Height="230" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <GroupBox Header="Format" Margin="0,0,0,14">
            <StackPanel Margin="10">
                <RadioButton x:Name="CsvRadio" Content="CSV" IsChecked="True" Margin="0,0,0,6" />
                <RadioButton x:Name="JsonRadio" Content="JSON" Margin="0,0,0,10" />
                <CheckBox x:Name="IncludeArchivedBox" Content="Include archived tasks" />
            </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Export..." Width="125" Margin="0,0,12,0" Click="Export_Click" />
            <Button Content="Import..." Width="125" Click="Import_Click" />
        </StackPanel>
    </StackPanel>
</Window>
