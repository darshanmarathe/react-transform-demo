<Window x:Class="VibeTasks.Wpf.Dialogs.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Users" Height="430" Width="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="NameBox" Width="180" Margin="0,0,8,0" ToolTip="Name" />
            <TextBox x:Name="EmailBox" Width="220" Margin="0,0,8,0" ToolTip="Email" />
            <Button Content="Add" Width="70" Margin="0,0,8,0" Click="Add_Click" />
            <Button Content="Update" Width="80" Margin="0,0,8,0" Click="Update_Click" />
            <Button Content="Delete" Width="80" Click="Delete_Click" />
        </StackPanel>

        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="UsersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="3*" />
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
