<Window x:Class="VibeTasks.Wpf.Dialogs.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task" Height="520" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Title" VerticalAlignment="Center" />
        <TextBox x:Name="TitleBox" Grid.Column="1" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Text="Description" VerticalAlignment="Top" Margin="0,4,0,0" />
        <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="1" Height="110" Margin="0,0,0,10"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="2" Text="Status" VerticalAlignment="Center" />
        <ComboBox x:Name="StatusBox" Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,10" />

        <TextBlock Grid.Row="3" Text="Priority" VerticalAlignment="Center" />
        <ComboBox x:Name="PriorityBox" Grid.Row="3" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,10" />

        <TextBlock Grid.Row="4" Text="Assigned user" VerticalAlignment="Center" />
        <ComboBox x:Name="UserBox" Grid.Row="4" Grid.Column="1" Width="240" HorizontalAlignment="Left" Margin="0,0,0,10"
                  DisplayMemberPath="Name" SelectedValuePath="Id" />

        <TextBlock Grid.Row="5" Text="Due date" VerticalAlignment="Center" />
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="HasDueDateBox" Content="Set" Margin="0,0,12,0" VerticalAlignment="Center" />
            <DatePicker x:Name="DueDatePicker" Width="160" />
        </StackPanel>

        <TextBlock Grid.Row="6" Text="Recurring" VerticalAlignment="Top" Margin="0,4,0,0" />
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Vertical">
            <CheckBox x:Name="RecurringBox" Content="Repeat this task" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="RecurrenceBox" Width="160" Margin="0,0,12,0" />
                <TextBlock Text="Count" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="RecurrenceCountBox" Width="70" Text="1" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Save" Width="95" Margin="0,0,10,0" Click="Save_Click" />
            <Button Content="Cancel" Width="95" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
